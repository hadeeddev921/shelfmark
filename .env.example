# Example environment for local development.
# Copy to .env and load it into your shell before running the app:
#   set -a; source .env; set +a
# Every variable prefixed with INVENIO_ overrides the matching setting in
# shelfmark/config.py. The values below match the services in docker-compose.yml.
# Placeholders only: never commit real secrets.

# Secret used to sign sessions and tokens (use a long random string)
INVENIO_SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL
INVENIO_SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://test:psw@localhost/ils

# Redis
INVENIO_CACHE_TYPE=redis
INVENIO_CACHE_REDIS_URL=redis://localhost:6379/0
INVENIO_ACCOUNTS_SESSION_REDIS_URL=redis://localhost:6379/1
INVENIO_CELERY_RESULT_BACKEND=redis://localhost:6379/2
INVENIO_RATELIMIT_STORAGE_URI=redis://localhost:6379/3

# RabbitMQ
INVENIO_BROKER_URL=amqp://guest:guest@localhost:5672/
INVENIO_CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/

# OpenSearch
INVENIO_SEARCH_HOSTS=['localhost:9200']

# URL of the React web app that uses this API
INVENIO_SPA_HOST=https://127.0.0.1:3000

# CSRF check on the REST API (set to False only for local development)
INVENIO_REST_CSRF_ENABLED=True

# Host IP that Docker Compose binds service ports to
DOCKER_SERVICES_IP_BIND=127.0.0.1
